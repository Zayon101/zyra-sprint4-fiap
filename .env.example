# Copie este arquivo para .env e preencha com os dados do seu Oracle da FIAP.
# Não compartilhe o arquivo .env preenchido e não envie senhas no ZIP.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521

# Use APENAS um dos campos abaixo, conforme o SQL Developer da FIAP.
# Se o tipo de conexão for 'Nome do serviço', preencha ORACLE_SERVICE_NAME.
# Se o tipo for 'SID', preencha ORACLE_SID.
ORACLE_SERVICE_NAME=
ORACLE_SID=
